@prefix : <http://it6390e-group2.example.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

# Classes

:Person a owl:Class ;
    owl:equivalentClass foaf:Person ;
    rdfs:label "Person"@en .

:Director a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Director"@en .

:Actor a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Actor"@en .

:Movie a owl:Class ;
    owl:equivalentClass schema:Movie ;
    rdfs:label "Movie"@en .

:Genre a owl:Class ;
    rdfs:label "Genre"@en .

:Studio a owl:Class ;
    rdfs:label "Studio"@en .

:Country a owl:Class ;
    rdfs:label "Country"@en .

# Properties

:hasGenre a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Genre ;
    rdfs:label "has genre"@en .

:producedBy a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Studio ;
    rdfs:label "produced by"@en .

:producedIn a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Country ;
    rdfs:label "produced in"@en .

:releaseYear a owl:DatatypeProperty ;
    rdfs:domain :Movie ;
    rdfs:range xsd:integer ;
    rdfs:label "release year"@en .

# dbo:director and dbo:starring are reused from DBpedia, but must be declared
# here as object properties: undeclared, Protege/HermiT don't treat them as
# object properties and the SWRL rule below can't use them.

dbo:director a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Director ;
    rdfs:label "director"@en .

dbo:starring a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Actor ;
    rdfs:label "starring"@en .

# dc:title / foaf:name are annotation-style literals, nothing to declare.

# Genre individuals (kept as named individuals, not literals, so they can be
# used in hasValue restrictions below)

:genre_action a :Genre ; rdfs:label "Action"@en .
:genre_comedy a :Genre ; rdfs:label "Comedy"@en .

# Defined classes: the reasoner classifies movies into these automatically
# from hasGenre, instead of us tagging each movie by hand (same idea as
# pizza.owl's VegetarianPizza).

:ActionMovie a owl:Class ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasGenre ;
        owl:hasValue :genre_action
    ] ;
    rdfs:label "Action Movie"@en .

:ComedyMovie a owl:Class ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty :hasGenre ;
        owl:hasValue :genre_comedy
    ] ;
    owl:disjointWith :ActionMovie ;
    rdfs:label "Comedy Movie"@en .

:Award a owl:Class ;
    rdfs:label "Award"@en .

:hasAward a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Award ;
    rdfs:label "has award"@en .

:AwardWinningDirector a owl:Class ;
    rdfs:subClassOf :Director ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Director
            [ a owl:Restriction ; owl:onProperty :hasAward ; owl:someValuesFrom :Award ]
        )
    ] ;
    rdfs:label "Award-winning Director"@en .

# Target class for the SWRL rule in rules.swrl (can't be built from a plain
# OWL restriction - see the comment in that file).
:ActorDirector a owl:Class ;
    rdfs:subClassOf :Person ;
    rdfs:label "Actor-Director"@en .
